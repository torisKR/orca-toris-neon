{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "toris-neon",
  "name": "Toris Neon · App Studio",
  "version": "0.2.0",
  "description": "앱 제작 그래프, 멀티 에이전트 수정 루프, Play Store 점검과 오늘 이어하기.",
  "engines": {
    "orca": ">=1.4.260"
  },
  "pluginApi": 1,
  "main": "src/worker.mjs",
  "repository": "https://github.com/torisKR/orca-toris-neon",
  "homepage": "https://github.com/torisKR/orca-toris-neon",
  "license": "MIT",
  "author": {
    "name": "torisKR",
    "url": "https://toris.kr"
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "workspace:create"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "terminal:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "history:read"
    },
    {
      "kind": "notifications:show"
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "studio",
        "title": "Toris Neon",
        "icon": "rocket",
        "entry": "panel/index.html",
        "ui": "html"
      }
    ],
    "commands": [
      {
        "id": "neon.today",
        "title": "Toris Neon: 오늘 이어하기"
      },
      {
        "id": "neon.graph",
        "title": "Toris Neon: Auto App 상태"
      },
      {
        "id": "neon.play",
        "title": "Toris Neon: Play Store 점검 상태"
      },
      {
        "id": "neon.remote",
        "title": "Toris Neon: 원격 제어(봇) 안내"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "pipeline",
        "text": "Toris Neon",
        "icon": "activity",
        "tooltip": "앱 제작 흐름과 이어하기",
        "command": "neon.today"
      }
    ],
    "settings": [
      {
        "key": "worklogRoot",
        "title": "작업 일지 폴더",
        "description": "비어 있으면 ~/projects/toris-docs/journal/dev에서 오늘과 어제의 일지를 읽습니다. 일지는 수정하지 않습니다.",
        "type": "string",
        "default": "",
        "maxLength": 2048
      },
      {
        "key": "maxActiveJobs",
        "title": "Neon 동시 작업 수",
        "description": "모든 실행을 합쳐 Neon이 동시에 배정하는 작업 수입니다(기본 2). Neon이 배정하지 않은 에이전트는 세지 않습니다.",
        "type": "number",
        "default": 2,
        "minimum": 1,
        "maximum": 8
      },
      {
        "key": "maxHeavyJobs",
        "title": "Neon 동시 빌드·기기 작업 수",
        "description": "빌드·테스트·기기 작업처럼 무거운 작업의 동시 배정 수입니다(기본 1). 동시 작업 수보다 클 수 없습니다.",
        "type": "number",
        "default": 1,
        "minimum": 1,
        "maximum": 8
      },
      {
        "key": "defaultProfile",
        "title": "Auto App 기본 프로필",
        "description": "새 실행의 속도·비용 프로필 기본값입니다: fast(가장 빠름, 상위 모델, 구현 병렬 5), balanced(기본, 구현·테스트는 상위 모델, 문서는 중간 모델, 교차 검토, 구현 병렬 3), saver(절약, 검토는 가벼운 모델, 병렬 없음). 실행을 만들 때 바꿀 수 있습니다.",
        "type": "string",
        "default": "balanced",
        "maxLength": 16
      },
      {
        "key": "historyExportDir",
        "title": "기록 내보내기 폴더",
        "description": "다른 PC에서 볼 끝난 실행 기록(JSON과 HTML 스냅샷)을 실행 ID별 폴더로 내보낼 곳입니다. 비공개 저장소나 동기화 폴더를 지정하세요. 공개 저장소 안이면 내보내지 않습니다. 실행 카드의 내보내기 버튼을 누를 때만 씁니다.",
        "type": "string",
        "default": "",
        "maxLength": 2048
      },
      {
        "key": "notifications",
        "title": "작업 알림",
        "description": "검토와 승인 대기 시 알림을 표시합니다.",
        "type": "boolean",
        "default": true
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before"
      }
    ]
  }
}
